{
  "name": "click-tourism-mcp-gateway",
  "version": "0.2.0",
  "private": true,
  "description": "Read-only MCP gateway (stages 1-2) for the Click Tourism ERP. Calls /api/v1 with the user's own mcp:read token; no database access.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=20" },
  "bin": { "click-tourism-mcp": "src/index.js" },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "export:catalogue": "node scripts/export-catalogue.js > ../backend/resources/assistant/tools.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}

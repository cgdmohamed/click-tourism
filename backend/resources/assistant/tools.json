    {
      "name": "erp_party_statement",
      "description": "Account statement of one customer or supplier for a date range, with opening and closing balance (read-only; employees are not available). Money is in integer minor units.",
      "route": "/reports/party-statement",
      "report": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "party_type",
          "party_id",
          "from",
          "to"
        ],
        "properties": {
          "party_type": {
            "enum": [
              "customer",
              "supplier"
            ]
          },
          "party_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "branch_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    {
      "name": "erp_aging",
      "description": "Receivables (ar) or payables (ap) aging buckets as of a date (read-only). Money is in integer minor units.",
      "route": "/reports/aging",
      "report": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "as_of"
        ],
        "properties": {
          "type": {
            "enum": [
              "ar",
              "ap"
            ]
          },
          "as_of": {
            "type": "string",
            "format": "date"
          },
          "branch_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    {
      "name": "erp_trial_balance",
      "description": "Trial balance for a date range (read-only). Money is in integer minor units; totals come from the ERP, do not recompute them.",
      "route": "/reports/trial-balance",
      "report": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "pre_closing": {
            "type": "boolean"
          },
          "max_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "adjustments": {
            "enum": [
              "include",
              "exclude",
              "only"
            ]
          },
          "branch_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      }
    },

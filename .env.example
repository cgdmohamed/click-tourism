# Copy to .env in the repository root and fill in. Never commit .env.
#
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
#
# Docker Compose reads this file for both variable interpolation and the
# backend container environment. Generate APP_KEY with:
#   cd backend && php artisan key:generate --show

APP_NAME="Tourism ERP"
# Release version reported by /api/v1/health. Set by the release build.
APP_VERSION=0.1.0
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
APP_LOCALE=ar
APP_TIMEZONE=Africa/Cairo
FRONTEND_URL=http://localhost:8080
LOG_LEVEL=warning

# Public port for the web container.
WEB_PORT=8080

# PostgreSQL. Generate a long random password (for example `openssl rand -hex 24`)
# and keep it out of version control. Deliberately EMPTY: compose refuses to start
# without it and the backend refuses well-known values such as "change-me".
POSTGRES_DB=tourism_erp
POSTGRES_USER=tourism
POSTGRES_PASSWORD=

# Create/upgrade the schema on container start. There is NO demo data in a real
# installation: the first administrator and the company profile are created once
# with `php artisan erp:install` (see docs/deployment/clean-install-acceptance.md).
# Pass ERP_ADMIN_PASSWORD only for that single command, never store it here.
RUN_MIGRATIONS=true
SEED_DEMO=false
APP_OPTIMIZE=true

# Sanctum personal access tokens expire after this many minutes (30 days).
# 0 disables expiry; the daily scheduler prunes tokens dead for over a week.
SANCTUM_TOKEN_EXPIRATION=43200

# Meta / WhatsApp webhooks. Leave empty until real credentials exist;
# the API returns 503 webhook_not_configured in production without them.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Copy to .env in the repository root and fill in. Never commit .env.
#
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
#
# Docker Compose reads this file for both variable interpolation and the
# backend container environment. Generate APP_KEY with:
#   cd backend && php artisan key:generate --show

APP_NAME="Tourism ERP"
# Release version reported by /api/v1/health. Set by the release build.
APP_VERSION=0.1.0
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
APP_LOCALE=ar
APP_TIMEZONE=Africa/Cairo
FRONTEND_URL=http://localhost:8080
LOG_LEVEL=warning

# Public port for the web container.
WEB_PORT=8080

# PostgreSQL. Use a long random password and keep it out of version control.
POSTGRES_DB=tourism_erp
POSTGRES_USER=tourism
POSTGRES_PASSWORD=change-me

# First boot only: create schema and (optionally) demo data.
RUN_MIGRATIONS=true
SEED_DEMO=false
APP_OPTIMIZE=true

# Meta / WhatsApp webhooks. Leave empty until real credentials exist;
# the API returns 503 webhook_not_configured in production without them.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
